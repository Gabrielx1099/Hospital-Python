# Configuración de correo para Flask-Mail (Hospital Lanfranco La Hoz)
# Copia este archivo como .env y completa los valores reales.
# NO subas el archivo .env al repositorio.

# Servidor SMTP (Gmail gratuito)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Credenciales del remitente
# Para Gmail: usa una "Contraseña de aplicación" (no tu contraseña normal).
# Generarla en: Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones.
# Es gratuita y no requiere ninguna API de pago.
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_DEFAULT_SENDER=tu_correo@gmail.com
